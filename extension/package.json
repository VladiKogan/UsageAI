{
  "name": "usageai",
  "displayName": "UsageAI",
  "description": "Keep Codex, Claude Code, GitHub Copilot, and Gemini usage visible while you code.",
  "version": "0.1.25",
  "publisher": "vladikogan",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "usage",
    "usage-monitor",
    "quota",
    "limits",
    "rate-limit",
    "tokens",
    "status-bar",
    "codex",
    "openai",
    "claude",
    "claude-code",
    "anthropic",
    "copilot",
    "github-copilot",
    "gemini",
    "antigravity",
    "antigravity-ide"
  ],
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/VladiKogan/UsageAI"
  },
  "vsce": {
    "baseContentUrl": "https://github.com/VladiKogan/UsageAI/blob/main/extension",
    "baseImagesUrl": "https://raw.githubusercontent.com/VladiKogan/UsageAI/main/extension"
  },
  "bugs": {
    "url": "https://github.com/VladiKogan/UsageAI/issues"
  },
  "homepage": "https://github.com/VladiKogan/UsageAI#readme",
  "main": "./dist/src/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:usageai.dashboard"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "icons": {
      "usageai-codex": {
        "description": "Codex provider",
        "default": {
          "fontPath": "./media/usageai-providers.woff",
          "fontCharacter": "\\E001"
        }
      },
      "usageai-claude": {
        "description": "Claude provider",
        "default": {
          "fontPath": "./media/usageai-providers.woff",
          "fontCharacter": "\\E002"
        }
      },
      "usageai-copilot": {
        "description": "GitHub Copilot provider",
        "default": {
          "fontPath": "./media/usageai-providers.woff",
          "fontCharacter": "\\E003"
        }
      },
      "usageai-gemini": {
        "description": "Google Gemini provider",
        "default": {
          "fontPath": "./media/usageai-providers.woff",
          "fontCharacter": "\\E004"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "usageai",
          "title": "UsageAI",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "usageai": [
        {
          "type": "webview",
          "id": "usageai.dashboard",
          "name": "UsageAI",
          "icon": "media/activity.svg",
          "contextualTitle": "UsageAI"
        }
      ]
    },
    "commands": [
      {
        "command": "usageai.show",
        "title": "Show Usage",
        "category": "UsageAI"
      },
      {
        "command": "usageai.refresh",
        "title": "Refresh",
        "category": "UsageAI",
        "icon": "$(refresh)"
      },
      {
        "command": "usageai.openSettings",
        "title": "Open Settings",
        "category": "UsageAI",
        "icon": "$(gear)"
      },
      {
        "command": "usageai.addAccount",
        "title": "Add Account…",
        "category": "UsageAI"
      },
      {
        "command": "usageai.manageAccounts",
        "title": "Manage Accounts…",
        "category": "UsageAI"
      },
      {
        "command": "usageai.rescanAccounts",
        "title": "Rescan Accounts",
        "category": "UsageAI"
      },
      {
        "command": "usageai.chooseStatusBarItems",
        "title": "Choose Status Bar Items…",
        "category": "UsageAI"
      }
    ],
    "submenus": [
      {
        "id": "usageai.accountsMenu",
        "label": "Accounts",
        "icon": "$(account)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "usageai.refresh",
          "when": "view == usageai.dashboard",
          "group": "navigation@1"
        },
        {
          "submenu": "usageai.accountsMenu",
          "when": "view == usageai.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "usageai.openSettings",
          "when": "view == usageai.dashboard",
          "group": "navigation@3"
        },
        {
          "command": "usageai.chooseStatusBarItems",
          "when": "view == usageai.dashboard",
          "group": "statusbar@1"
        }
      ],
      "usageai.accountsMenu": [
        {
          "command": "usageai.addAccount",
          "group": "1_accounts@1"
        },
        {
          "command": "usageai.manageAccounts",
          "group": "1_accounts@2"
        },
        {
          "command": "usageai.rescanAccounts",
          "group": "2_find@1"
        }
      ]
    },
    "configuration": [
      {
        "title": "Providers and Accounts",
        "order": 10,
        "properties": {
          "usageai.providers": {
            "type": "array",
            "default": [
              "codex",
              "claude",
              "copilot",
              "gemini"
            ],
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "codex",
                "claude",
                "copilot",
                "gemini"
              ]
            },
            "order": 10,
            "description": "Providers to show, and their starting order in the dashboard and Status Bar. To arrange the cards, drag them in the dashboard."
          },
          "usageai.accounts": {
            "type": "array",
            "default": [],
            "maxItems": 16,
            "scope": "application",
            "items": {
              "type": "object",
              "required": [
                "provider",
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex"
                  ],
                  "description": "Which provider the login belongs to."
                },
                "path": {
                  "type": "string",
                  "description": "Absolute path of a local login folder: a CLAUDE_CONFIG_DIR holding .credentials.json, or a CODEX_HOME holding auth.json."
                },
                "label": {
                  "type": "string",
                  "maxLength": 64,
                  "description": "The name shown on the account's card. Without one, its email or folder name is used."
                },
                "hidden": {
                  "type": "boolean",
                  "default": false,
                  "description": "Keep this login out of the dashboard and Status Bar."
                }
              }
            },
            "order": 20,
            "markdownDescription": "Extra Claude Code and Codex logins, each a login folder of its own. You do not need to edit this list: [Manage Accounts…](command:usageai.manageAccounts) renames, hides, shows or removes any account, and [Add Account…](command:usageai.addAccount) adds one.\n\nFolders named `.claude-*` or `.codex-*` in your home folder are found automatically. An entry needs the absolute local path of a folder that holds the provider's credential file; a `label` or `hidden` flag also applies to a found folder or the main login."
          },
          "usageai.enableGitHubCliFallback": {
            "type": "boolean",
            "default": false,
            "order": 30,
            "description": "GitHub Copilot: allow UsageAI to run `gh auth token` when no Copilot credential file is usable."
          },
          "usageai.showProviderIncidents": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "order": 40,
            "description": "Show an ongoing incident from the providers' public status pages (status.claude.com, www.githubstatus.com, status.openai.com) in the Status Bar tooltip and on the provider's card. The pages are read at most every five minutes, without any credential."
          }
        }
      },
      {
        "title": "Status Bar",
        "order": 20,
        "properties": {
          "usageai.statusBarProviders.codex": {
            "type": "boolean",
            "default": false,
            "order": 10,
            "markdownDescription": "Show Codex (your main login, `~/.codex`) in the Status Bar. [Choose Status Bar Items…](command:usageai.chooseStatusBarItems) sets every Status Bar item in one list, and is where extra Claude Code and Codex accounts are added."
          },
          "usageai.statusBarProviders.claude": {
            "type": "boolean",
            "default": false,
            "order": 20,
            "markdownDescription": "Show Claude Code (your main login, `~/.claude`) in the Status Bar."
          },
          "usageai.statusBarProviders.copilot": {
            "type": "boolean",
            "default": false,
            "order": 30,
            "markdownDescription": "Show GitHub Copilot in the Status Bar."
          },
          "usageai.statusBarProviders.gemini": {
            "type": "boolean",
            "default": false,
            "order": 40,
            "markdownDescription": "Show Gemini in the Status Bar."
          },
          "usageai.statusBarProviders.hottestWhenNoneSelected": {
            "type": "boolean",
            "default": true,
            "order": 50,
            "markdownDescription": "When nothing above is chosen, show whichever provider has the highest usage right now. Turn this off as well to keep UsageAI out of the Status Bar."
          }
        }
      },
      {
        "title": "Display",
        "order": 30,
        "properties": {
          "usageai.quotaDisplay": {
            "type": "string",
            "enum": [
              "used",
              "remaining"
            ],
            "enumDescriptions": [
              "Meters fill with, and percentages show, the quota already used.",
              "Meters fill with, and percentages show, the quota still left."
            ],
            "default": "used",
            "scope": "application",
            "order": 10,
            "description": "Show quota used or quota remaining, in the dashboard meters and the Status Bar. Warning and critical levels keep their meaning either way."
          },
          "usageai.metricDisplayMode": {
            "type": "string",
            "enum": [
              "all",
              "metered",
              "important"
            ],
            "enumDescriptions": [
              "Show every metric reported by each provider.",
              "Show every metric with a usable percentage.",
              "Show the highest-used Session, Rolling, and Monthly metric."
            ],
            "default": "all",
            "scope": "application",
            "order": 20,
            "description": "Which limits an expanded dashboard card lists. Collapsed summaries and the Status Bar are unchanged."
          },
          "usageai.warningPercent": {
            "type": "number",
            "default": 72,
            "minimum": 1,
            "maximum": 100,
            "order": 30,
            "description": "Usage percentage at which meters turn to the warning colour. Always measured as quota used, even when meters show quota remaining."
          },
          "usageai.criticalPercent": {
            "type": "number",
            "default": 90,
            "minimum": 1,
            "maximum": 100,
            "order": 40,
            "description": "Usage percentage at which meters turn to the critical colour. Always measured as quota used, even when meters show quota remaining."
          }
        }
      },
      {
        "title": "Refresh",
        "order": 40,
        "properties": {
          "usageai.refreshIntervalMinutes": {
            "type": "number",
            "default": 5,
            "minimum": 1,
            "maximum": 120,
            "order": 10,
            "description": "Minutes between refreshes while the UsageAI view is open."
          },
          "usageai.backgroundRefreshIntervalMinutes": {
            "type": "number",
            "default": 15,
            "minimum": 5,
            "maximum": 240,
            "order": 20,
            "description": "Minutes between refreshes while the UsageAI view is hidden."
          }
        }
      }
    ]
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compile && node --import ./dist/test/setup.js --test dist/test/*.test.js",
    "test:coverage": "npm run compile && node --experimental-test-coverage --test-coverage-include=dist/src/**/*.js --test-coverage-lines=70 --test-coverage-branches=65 --test-coverage-functions=75 --import ./dist/test/setup.js --test dist/test/*.test.js",
    "previews": "npm run compile && node ./scripts/render-previews.mjs",
    "vscode:prepublish": "npm run compile",
    "package:vsix": "vsce package",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
